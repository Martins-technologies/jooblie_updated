NODE_ENV=development
PORT=4000

# Supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public frontend origins, comma-separated. Never use * in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Reverse proxy. Keep false when Node is directly exposed locally. Use the exact trusted hop count (commonly 1) behind your production proxy.
TRUST_PROXY=false

# API behavior
DEFAULT_SITE_SLUG=jooblie
LOG_LEVEL=info
REQUEST_BODY_LIMIT=256kb

# General rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Strict auth/write limits
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
WRITE_RATE_LIMIT_WINDOW_MS=60000
WRITE_RATE_LIMIT_MAX=30

# Initial Administrator Provisioning (Never expose this to frontend or with NEXT_PUBLIC_/VITE_)
INITIAL_ADMIN_EMAIL=admin@example.com


# Contact delivery (server only). Verify sender domain with Resend first.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
