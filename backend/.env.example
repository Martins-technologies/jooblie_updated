NODE_ENV=development
PORT=5001

# Supabase
SUPABASE_URL=https://navfstsrwraemrqbypbe.supabase.co
SUPABASE_ANON_KEY=sb_publishable_ooN5nmNIarCAG6sN4uCi-A_RnGSkq-p
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Public frontend origins, comma-separated. Never use * in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Reverse proxy. Keep false when Node is directly exposed locally. Use the exact trusted hop count (commonly 1) behind your production proxy.
TRUST_PROXY=false

# API behavior
DEFAULT_SITE_SLUG=jooblie
LOG_LEVEL=info
REQUEST_BODY_LIMIT=256kb

# General rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Strict auth/write limits
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
WRITE_RATE_LIMIT_WINDOW_MS=60000
WRITE_RATE_LIMIT_MAX=30

# Initial Administrator Provisioning (Never expose this to frontend or with NEXT_PUBLIC_/VITE_)
INITIAL_ADMIN_EMAIL=haroondmin@gmail.com

# Optional Mississauga delivery worker. Apply migration 012 and approve providers
# before enabling. Values remain server-side; never use VITE_ for these.
MISSISSAUGA_CRM_ENABLED=false
MISSISSAUGA_CRM_WEBHOOK_URL=
MISSISSAUGA_CRM_WEBHOOK_TOKEN=
MISSISSAUGA_CRM_PIPELINE_ID=
MISSISSAUGA_CRM_STAGE_ID=
MISSISSAUGA_CRM_OWNER_ID=
MISSISSAUGA_RECEIPT_ENABLED=false
MISSISSAUGA_WORKER_SECRET=
MISSISSAUGA_FROM_EMAIL=
RESEND_API_KEY=
