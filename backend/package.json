{
  "name": "jooblie-shared-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared secure API for Jooblie and its specialist portals",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "provision-admin": "node scripts/provision-admin.js",
    "registration:deliver": "node scripts/deliver-registrations.js",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "node --check server.js && node --check src/app.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "mammoth": "^1.13.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "overrides": {
    "nodemon": {
      "minimatch": "^11.0.1"
    }
  }
