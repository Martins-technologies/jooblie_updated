# Shared Supabase project (same values on every frontend portal)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Shared Node/Express API
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Set ONE canonical database slug for this deployment.
# Current active repo mappings:
# Jooblie                  -> jooblie
# office-jobline           -> office-jobs
# IT jobline               -> it-jobs
# service-care-jobline     -> service-care
# health-care jobline      -> health-care
# farmerfreight-jobline    -> farmerfreight
# aboriginal-jobline       -> aboriginal
# newcomer-jobline         -> newcomers
# Legacy configured rows also present in DB: hospitality-healthcare, transport-farming
VITE_SITE_SLUG=jooblie
# Optional brand label; known portal slugs already have matching names.
VITE_SITE_NAME=

# Optional links used by the Jooblie homepage category cards.
VITE_PORTAL_IT_SOFTWARE_URL=
VITE_PORTAL_OFFICE_ADMIN_URL=
VITE_PORTAL_RESTAURANT_URL=
VITE_PORTAL_AGRICULTURE_URL=
VITE_PORTAL_TRUCKING_URL=

VITE_SUPPORT_EMAIL=
